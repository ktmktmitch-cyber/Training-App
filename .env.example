# Copy to .env and fill in. Everything here is optional:
# the app also lets you paste your intervals.icu key in Settings (stored only in your browser).

# Port for the Node server (serves the app + API proxy)
PORT=8787

# --- Accounts (multi-user; on by default) ---
# Everyone logs in with their own intervals.icu account. Their encrypted credentials and
# app state live in DATA_DIR — put it on a persistent disk/volume when you deploy.
ACCOUNTS=on
DATA_DIR=./data
# Long random string used to encrypt stored credentials and sign sessions.
# (If empty, one is generated into DATA_DIR/secret.key — keep that file.)
SESSION_SECRET=
# Optional: "Log in with intervals.icu" (OAuth). Ask intervals.icu for an OAuth client;
# redirect URL = <PUBLIC_URL>/api/auth/oauth/callback
INTERVALS_CLIENT_ID=
INTERVALS_CLIENT_SECRET=
# Optional: comma-separated intervals.icu athlete IDs that get the coach view
# (coaches are also detected automatically from the API key)
COACH_IDS=

# --- Single-user mode only (ACCOUNTS=off) ---
# intervals.icu → Settings → Developer Settings → API Key
ICU_API_KEY=
ICU_ATHLETE_ID=

# --- Strava (optional) ---
# Create an app at https://www.strava.com/settings/api
# Authorization Callback Domain: the host you run this on (e.g. localhost)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Public URL of this server, used to build the OAuth redirect (no trailing slash)
PUBLIC_URL=http://localhost:8787

# --- Optional site password in front of everything (e.g. a team password) ---
APP_PASSWORD=
