{
  "name": "training-app",
  "private": true,
  "version": "1.0.0",
  "description": "Adaptive cycling + strength planner powered by intervals.icu (Garmin/Strava data), HRV/RHR readiness and modern periodization.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"node --watch server/index.mjs\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "preview": "npm run build && npm start",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.1.1"
  }
}
